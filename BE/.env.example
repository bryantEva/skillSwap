# ─── Database ─────────────────────────────────────────────────────────────────
# Connection string MySQL. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/skillswap"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret untuk menandatangani JWT. Ganti dengan string acak yang panjang & rahasia.
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# ─── Server ───────────────────────────────────────────────────────────────────
# Port tempat BE berjalan. Opsional, default 3000.
PORT=3000
