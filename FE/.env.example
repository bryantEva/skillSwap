# Alamat BE yang dipakai proxy Vite saat `npm run dev` (request /api/* -> BE)
VITE_BACKEND_URL=http://localhost:3000

# Opsional: base URL API saat build production. Default "/api" (lewat proxy/reverse proxy).
# Kalau diisi URL absolut (misal https://api.skillswap.id), BE harus mengaktifkan CORS.
# VITE_API_URL=/api
